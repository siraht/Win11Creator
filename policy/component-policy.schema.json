{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:winutil:schema:component-policy:1",
  "title": "WinUtil component policy v1",
  "type": "object",
  "required": ["schemaVersion", "documentType"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "documentType": { "enum": ["component-catalog", "component-profile"] },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    },
    "exclusiveGroups": {
      "type": "array",
      "items": { "$ref": "#/$defs/exclusiveGroup" }
    },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "actions": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/action" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "documentType": { "const": "component-catalog" } } },
      "then": { "required": ["components"] }
    },
    {
      "if": { "properties": { "documentType": { "const": "component-profile" } } },
      "then": { "required": ["id", "name", "description", "actions"] }
    }
  ],
  "$defs": {
    "action": {
      "enum": ["keep", "remove", "disable", "manual", "protected"]
    },
    "risk": {
      "enum": ["safe", "moderate", "high", "expert"]
    },
    "matchType": {
      "enum": ["exact", "wildcard", "version-insensitive"]
    },
    "conflictSeverity": {
      "enum": ["warning", "likely-breakage", "forbidden-unless-expert"]
    },
    "conflict": {
      "type": "object",
      "required": ["action", "with", "withAction", "severity", "reason"],
      "properties": {
        "action": { "$ref": "#/$defs/action" },
        "with": { "type": "string", "minLength": 1 },
        "withAction": { "$ref": "#/$defs/action" },
        "severity": { "$ref": "#/$defs/conflictSeverity" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["operation", "onAction", "hive", "key", "name", "type", "value"],
          "properties": {
            "operation": { "const": "set-registry-value" },
            "onAction": { "enum": ["remove", "disable"] },
            "hive": { "enum": ["SOFTWARE", "SYSTEM", "DEFAULT"] },
            "key": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "type": { "enum": ["REG_SZ", "REG_EXPAND_SZ", "REG_DWORD", "REG_QWORD", "REG_MULTI_SZ", "REG_BINARY"] },
            "value": { "type": ["string", "number", "integer", "boolean"] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["operation", "onAction"],
          "properties": {
            "operation": { "const": "run-onedrive-uninstaller-at-setup" },
            "onAction": { "const": "remove" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["operation", "onAction"],
          "properties": {
            "operation": { "const": "remove-defender-offline" },
            "onAction": { "const": "remove" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["operation", "onAction", "serviceName", "startupType"],
          "properties": {
            "operation": { "const": "disable-service" },
            "onAction": { "enum": ["remove", "disable"] },
            "serviceName": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
            "startupType": { "const": "disabled" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["operation", "onAction", "taskPath"],
          "properties": {
            "operation": { "const": "disable-scheduled-task-at-setup" },
            "onAction": { "enum": ["remove", "disable"] },
            "taskPath": { "type": "string", "pattern": "^\\\\Microsoft\\\\Windows\\\\[^*?]+$" }
          },
          "additionalProperties": false
        }
      ]
    },
    "target": {
      "type": "object",
      "required": ["kind", "match", "matchType"],
      "properties": {
        "kind": {
          "enum": ["appx", "package", "capability", "feature", "registry", "service", "scheduled-task", "setup", "security"]
        },
        "match": { "type": "string", "minLength": 1 },
        "matchType": { "$ref": "#/$defs/matchType" },
        "allowMultiple": { "type": "boolean" },
        "operations": { "type": "array", "items": { "$ref": "#/$defs/operation" } }
      },
      "additionalProperties": false
    },
    "exclusiveGroup": {
      "type": "object",
      "required": ["id", "name", "description", "keepLabel", "members"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "keepLabel": { "type": "string", "minLength": 1 },
        "members": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "id", "name", "category", "defaultAction", "risk", "targets", "protects",
        "conflicts", "requires", "description", "reason", "consequences", "reversible", "exposed"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "defaultAction": { "$ref": "#/$defs/action" },
        "risk": { "$ref": "#/$defs/risk" },
        "targets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/target" } },
        "protects": { "type": "array", "items": { "type": "string" } },
        "conflicts": { "type": "array", "items": { "$ref": "#/$defs/conflict" } },
        "requires": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "consequences": { "type": "string", "minLength": 1 },
        "reversible": { "type": "boolean" },
        "exposed": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
