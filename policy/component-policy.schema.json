{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winutil.example/schema/component-policy-v1.json",
  "title": "WinUtil component policy v1",
  "type": "object",
  "required": ["schemaVersion", "documentType"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "documentType": { "enum": ["component-catalog", "component-profile"] },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "actions": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/action" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "documentType": { "const": "component-catalog" } } },
      "then": { "required": ["components"] }
    },
    {
      "if": { "properties": { "documentType": { "const": "component-profile" } } },
      "then": { "required": ["id", "name", "description", "actions"] }
    }
  ],
  "$defs": {
    "action": {
      "enum": ["keep", "remove", "disable", "manual", "protected"]
    },
    "risk": {
      "enum": ["safe", "moderate", "high", "expert"]
    },
    "target": {
      "type": "object",
      "required": ["kind", "match"],
      "properties": {
        "kind": {
          "enum": ["appx", "package", "capability", "feature", "registry", "service", "scheduled-task"]
        },
        "match": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "id", "name", "category", "defaultAction", "risk", "targets", "protects",
        "conflicts", "requires", "description", "reason", "consequences", "reversible", "exposed"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "defaultAction": { "$ref": "#/$defs/action" },
        "risk": { "$ref": "#/$defs/risk" },
        "targets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/target" } },
        "protects": { "type": "array", "items": { "type": "string" } },
        "conflicts": { "type": "array", "items": { "type": "string" } },
        "requires": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "consequences": { "type": "string", "minLength": 1 },
        "reversible": { "type": "boolean" },
        "exposed": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
