{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:winutil:schema:component-preset:1",
  "title": "WinUtil Win11 Creator component preset v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentType",
    "profileId",
    "actions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "documentType": {
      "const": "win11creator-component-preset"
    },
    "profileId": {
      "const": "custom"
    },
    "actions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "enum": [
          "keep",
          "remove",
          "disable",
          "manual",
          "protected"
        ]
      }
    }
  }
}
